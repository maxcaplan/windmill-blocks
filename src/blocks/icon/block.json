{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "windmill-blocks/icon",
	"version": "1.0.0",
	"title": "Icon",
	"category": "windmill-blocks",
	"description": "A small image to convey a meaning",
	"keywords": ["icon", "svg", "windmill"],
	"attributes": {
		"icon": {
			"type": "string",
			"role": "content"
		},
		"flipHorizontal": {
			"type": "boolean",
			"default": false
		},
		"flipVertical": {
			"type": "boolean",
			"default": false
		},
		"rotation": {
			"type": "number",
			"default": 0
		},
		"strokeWidth": {
			"type": "string"
		},
		"nonScalingStroke": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"ariaLabel": {
			"__experimentalSkipSerialization": true
		},
		"align": ["left", "center", "right"],
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": ["padding"]
		},
		"dimensions": {
			"width": true,
			"minWidth": true,
			"minHeight": true,
			"__experimentalSkipSerialization": ["width", "minWidth", "height"]
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"root": ".wp-block-windmill-blocks-icon svg",
		"css": ".wp-block-windmill-blocks-icon",
		"spacing": {
			"margin": ".wp-block-windmill-blocks-icon"
		}
	},
	"textdomain": "windmill-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
