{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "windmill-blocks/icon",
	"version": "1.0.0",
	"title": "Icon",
	"category": "windmill-blocks",
	"description": "A small image to convey a meaning",
	"keywords": ["image", "windmill"],
	"attributes": {
		"icon": {
			"type": "string",
			"role": "content"
		},
		"flipHorizontal": {
			"type": "boolean",
			"default": false
		},
		"flipVertical": {
			"type": "boolean",
			"default": false
		},
		"rotation": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"align": true,
		"ariaLabel": true,
		"dimensions": {
			"width": true,
			"minHeight": true,
			"minWidth": true
		}
	},
	"textdomain": "windmill-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
